# SAM JUNIOR environment configuration
#
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit
# secrets, and never expose keys to the frontend (no VITE_ prefix for secrets).
#
# Phase 0 needs NO environment variables. These placeholders document what
# arrives in later phases.

# --- Phase 2: AI provider (chat) ---
# ANTHROPIC_API_KEY=

# --- Logging (optional) ---
# Filter for the tracing subscriber, e.g. "debug" or "info,sam_core=trace"
# SAM_LOG=
