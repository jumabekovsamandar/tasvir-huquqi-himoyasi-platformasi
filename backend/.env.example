# ─── Application ───────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# ─── Database (PostgreSQL) ─────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/imagerights?schema=public"

# ─── Auth / JWT ────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ─── OAuth / OneID ─────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ONEID_CLIENT_ID=
ONEID_CLIENT_SECRET=
ONEID_REDIRECT_URI=http://localhost:4000/auth/oneid/callback

# ─── AWS S3 (xavfsiz fayl saqlash) ─────────────
AWS_REGION=eu-central-1
AWS_S3_BUCKET=imagerights-storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── AI servislari ─────────────────────────────
AI_DEEPFAKE_ENDPOINT=
AI_REVERSE_SEARCH_ENDPOINT=
AI_LEGAL_ASSISTANT_API_KEY=

# ─── Encryption ────────────────────────────────
ENCRYPTION_KEY=32_byte_hex_key_for_field_level_encryption
