// ImageRights.uz — ma'lumotlar bazasi sxemasi (Prisma / PostgreSQL)
// Asosiy oqim: DETECT → DOCUMENT → ANALYZE → PROTECT → RESOLVE

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum UserRole {
  USER
  LAWYER
  ADMIN
}

enum AuthProvider {
  EMAIL
  GOOGLE
  ONEID
}

enum PrivacyLevel {
  PRIVATE // faqat egasi ko‘radi
  RESTRICTED // egasi + biriktirilgan advokat
}

enum ImageState {
  ACTIVE
  ARCHIVED
}

enum ViolationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACTION_REQUIRED
  NOTICE_PREPARED
  LAWYER_REVIEW
  RESOLVED
  CLOSED
}

enum ViolationPlatform {
  INSTAGRAM
  FACEBOOK
  TELEGRAM
  YOUTUBE
  TIKTOK
  WEBSITE
  PRESS
  ADVERTISING
  OTHER
}

enum EvidenceKind {
  FILE
  URL
}

enum EvidenceType {
  SCREENSHOT
  ORIGINAL_IMAGE
  URL
  PDF_DOCUMENT
  CORRESPONDENCE
  OTHER
}

enum DocumentType {
  PLATFORM_COMPLAINT // platformaga shikoyat
  TAKEDOWN_REQUEST // olib tashlash talabi
  FORMAL_NOTICE // rasmiy ogohlantirish xati
  EVIDENCE_SUMMARY // dalillar xulosasi
  LAWYER_BRIEF // advokat uchun ish xulosasi
}

enum DocumentStatus {
  DRAFT
  FINALIZED
}

enum AIAnalysisKind {
  CASE_SUMMARY
  RISK_ASSESSMENT
  MISSING_INFO
  LAWYER_QUESTIONS
  DOCUMENT_DRAFT
}

enum NotificationType {
  CASE_SUBMITTED
  STATUS_CHANGED
  INFO_REQUESTED
  DOCUMENT_READY
  ADMIN_MESSAGE
  SECURITY
}

enum ContactStatus {
  NEW
  REVIEWED
  ARCHIVED
}

// ─────────────────────────────────────────────────────────────
// FOYDALANUVCHILAR
// ─────────────────────────────────────────────────────────────

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String? // OAuth foydalanuvchilarda bo‘lmasligi mumkin
  role          UserRole     @default(USER)
  provider      AuthProvider @default(EMAIL)
  oneIdPinfl    String?      @unique
  emailVerified Boolean      @default(false)
  isActive      Boolean      @default(true) // admin bloklashi mumkin
  deletedAt     DateTime? // soft delete
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  profile       Profile?
  lawyerProfile LawyerProfile?

  passwordResetTokens PasswordResetToken[]
  emailVerifyTokens   EmailVerifyToken[]
  images              ProtectedImage[]
  reports             ViolationReport[]
  assignedCases       Case[]               @relation("LawyerCases")
  evidence            Evidence[]
  documents           Document[]
  caseNotes           CaseNote[]
  caseMessages        CaseMessage[]
  notifications       Notification[]
  aiAnalyses          AIAnalysis[]
  auditLogs           AuditLog[]
  statusChanges       CaseStatusHistory[]

  @@index([role])
  @@index([isActive])
}

model Profile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  phone        String?
  organization String?
  avatarUrl    String?
  locale       String   @default("uz")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LawyerProfile {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber  String
  specialization String?
  experienceYears Int?
  bio            String?
  verified       Boolean   @default(false) // faqat admin tasdiqlaydi
  verifiedAt     DateTime?
  verifiedById   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([verified])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerifyToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// HIMOYALANGAN TASVIRLAR REYESTRI
// Eslatma: bu ichki reyestr — davlat intellektual mulk
// ro‘yxatidan o‘tkazish emas, dalillashga yordam beruvchi hujjat.
// ─────────────────────────────────────────────────────────────

model ProtectedImage {
  id           String       @id @default(uuid())
  ownerId      String
  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  registryCode String       @unique // masalan: IMG-2026-4F8A2C
  title        String
  description  String?

  storageKey String
  mimeType   String
  sizeBytes  Int
  width      Int?
  height     Int?
  sha256     String

  ownershipNote        String? // egalik haqida ma'lumot
  capturedAt           DateTime? // surat yaratilgan sana
  firstPublishedAt     DateTime? // birinchi e'lon qilingan sana
  publicationSource    String? // qayerda e'lon qilingan
  consentRestrictions  String? // rozilik cheklovlari
  commercialUseAllowed Boolean      @default(false)
  tags                 String[]     @default([])
  privacyLevel         PrivacyLevel @default(PRIVATE)

  state     ImageState @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  reports ViolationReport[]

  @@index([ownerId])
  @@index([state])
}

// ─────────────────────────────────────────────────────────────
// HUQUQBUZARLIK HISOBOTLARI VA ISHLAR
// ─────────────────────────────────────────────────────────────

model ViolationReport {
  id         String  @id @default(uuid())
  reporterId String
  reporter   User    @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  protectedImageId String?
  protectedImage   ProtectedImage? @relation(fields: [protectedImageId], references: [id], onDelete: SetNull)

  infringingUrl String?
  platform      ViolationPlatform @default(OTHER)
  platformOther String?
  publishedAt   DateTime? // e'lon qilingan sana (ma'lum bo‘lsa)
  discoveredAt  DateTime // aniqlangan sana
  description   String

  hadConsent     Boolean @default(false)
  consentDetails String?
  commercialUse  Boolean @default(false)
  damageDescription String?

  status    ViolationStatus @default(DRAFT)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  case     Case?
  evidence Evidence[]

  @@index([reporterId])
  @@index([status])
}

model Case {
  id         String @id @default(uuid())
  caseNumber String @unique // masalan: IR-2026-000123

  reportId String          @unique
  report   ViolationReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  assignedLawyerId String?
  assignedLawyer   User?   @relation("LawyerCases", fields: [assignedLawyerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusHistory CaseStatusHistory[]
  documents     Document[]
  notes         CaseNote[]
  messages      CaseMessage[]
  aiAnalyses    AIAnalysis[]

  @@index([assignedLawyerId])
}

model CaseStatusHistory {
  id          String          @id @default(uuid())
  caseId      String
  case        Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fromStatus  ViolationStatus?
  toStatus    ViolationStatus
  changedById String?
  changedBy   User?           @relation(fields: [changedById], references: [id], onDelete: SetNull)
  note        String?
  createdAt   DateTime        @default(now())

  @@index([caseId])
}

// Advokatning ichki eslatmalari — mijozga KO‘RINMAYDI
model CaseNote {
  id        String   @id @default(uuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([caseId])
}

// Mijoz ↔ advokat yozishmalari — ikkala tomonga ko‘rinadi
model CaseMessage {
  id        String   @id @default(uuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([caseId])
}

// ─────────────────────────────────────────────────────────────
// DALILLAR OMBORI
// ─────────────────────────────────────────────────────────────

model Evidence {
  id         String @id @default(uuid())
  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  reportId String
  report   ViolationReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  kind        EvidenceKind
  type        EvidenceType
  description String?

  // FILE turi uchun
  originalFilename String?
  storageKey       String? @unique
  mimeType         String?
  sizeBytes        Int?
  sha256           String?

  // URL turi uchun
  url String?

  createdAt DateTime @default(now())

  @@index([reportId])
  @@index([uploaderId])
}

// ─────────────────────────────────────────────────────────────
// HUQUQIY HUJJATLAR
// ─────────────────────────────────────────────────────────────

model Document {
  id          String @id @default(uuid())
  caseId      String
  case        Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  type             DocumentType
  title            String
  content          String // tahrirlanadigan matn
  senderName       String
  recipientName    String?
  recipientContact String?

  status      DocumentStatus @default(DRAFT)
  finalizedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([caseId])
}

// ─────────────────────────────────────────────────────────────
// AI TAHLILLARI
// Har bir natija axborot xarakteriga ega — yuridik maslahat emas.
// ─────────────────────────────────────────────────────────────

model AIAnalysis {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseId String?
  case   Case?  @relation(fields: [caseId], references: [id], onDelete: Cascade)

  kind   AIAnalysisKind
  output String
  model  String

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([caseId])
}

// ─────────────────────────────────────────────────────────────
// BILDIRISHNOMALAR
// ─────────────────────────────────────────────────────────────

model Notification {
  id     String           @id @default(uuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType
  title  String
  body   String?
  link   String?
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
}

// ─────────────────────────────────────────────────────────────
// ALOQA MUROJAATLARI
// ─────────────────────────────────────────────────────────────

model ContactSubmission {
  id      String        @id @default(uuid())
  name    String
  email   String
  phone   String?
  subject String
  message String
  status  ContactStatus @default(NEW)

  createdAt DateTime @default(now())

  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String  @id @default(uuid())
  userId     String?
  user       User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // masalan: IMAGE_REGISTERED, CASE_STATUS_CHANGED
  entityType String
  entityId   String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
